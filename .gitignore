# build artifacts
build/
# Anchored: this is the build output dir, and unanchored `bin/` would also
# swallow any nested bin/ a subdirectory legitimately tracks.
/bin/
libUniChecksum.so
libUniChecksum.so.*
libUniChecksum.dylib
libUniChecksum.a
*.o
*.obj
*.exe
*.dll
*.so
*.so.*
*.dylib
*.a
*.lib

# coverage
coverage/
lcov.info

# nim cache
nimcache/
rnimcache/
dnimcache/

# docs output
pages/
docs/
*.html
nimdoc.out.css

# python binding artifacts (sources tracked; generated + bundled lib not)
py/unichecksum/_core.c
py/unichecksum/*.so
py/unichecksum/libUniChecksum.so
py/dist/
py/build/
py/*.egg-info/
py/**/__pycache__/
py/.pytest_cache/
# vendored by setup.py (vendor_nim_source) right before `sdist` packages
# files -- shipped inside the sdist tarball, never tracked here
py/_nimsrc/

# c test/example binaries
tests/c/test_unichecksum
examples/c/demo

# os / editor
.DS_Store
*~
.*.swp
*.dSYM

*.log
*.core

# Compiling a chapter on its own makes nimib save a page beside it, whose
# stylesheet paths point wherever the build happened to be. Not a deliverable.
book/*.html

# nimibook's build output. `docs` copies it to pages/, which is what ships.
book/__site/
